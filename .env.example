# ==============================================================================
# CuraSphere HMS & Clinic Edition - Environment Configuration Template
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL (.gitignore excludes .env files)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL 15+)
# ------------------------------------------------------------------------------
POSTGRES_DB=curasphere_hms_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_secure_database_password_32_chars_recommended
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Or specify the full EF Core connection string directly for ASP.NET Core:
# ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=curasphere_hms_db;Username=postgres;Password=your_secret_password;Ssl Mode=Prefer;

# ------------------------------------------------------------------------------
# 2. JWT Security & Token Configuration
# ------------------------------------------------------------------------------
# JWT_SECRET MUST be at least 32 characters (256 bits) long for HMAC-SHA256
JWT_SECRET=replace_with_a_strong_random_signing_key_at_least_32_chars_long!
JWT_ISSUER=CuraSphereApi
JWT_AUDIENCE=CuraSphereClient
JWT_EXPIRY_MINUTES=60

# ------------------------------------------------------------------------------
# 3. ASP.NET Core Application Runtime & CORS Policy
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
# Set to 'false' in production; apply migrations via controlled CI/CD pipeline or release script
APPLY_MIGRATIONS=false
# Comma-separated list of allowed origins (e.g. your production domains)
CORS_ALLOWED_ORIGINS=https://clinic.curasphere.com,https://curasphere.com

# ------------------------------------------------------------------------------
# 4. Software Deployment Edition
# ------------------------------------------------------------------------------
# "Hospital" (full tertiary hospital suite) or "Clinic" (streamlined clinic workflows)
CURASPHERE_EDITION=Clinic
VITE_APP_EDITION=Clinic

# ------------------------------------------------------------------------------
# 5. Frontend Environment Variables (Vite Build-time)
# ------------------------------------------------------------------------------
# Production API URL (leave empty or use /api if behind an Nginx reverse proxy)
VITE_API_URL=https://api.curasphere.com/api
