{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=staging-postgres.internal.cloud.provider;Port=5432;Database=curasphere_staging_db;Username=curasphere_staging_app;Password=REPLACE_WITH_STAGING_PASSWORD;Ssl Mode=Require;Trust Server Certificate=true;"
  },
  "JwtSettings": {
    "Secret": "REPLACE_WITH_A_STAGING_JWT_SECRET_KEY_AT_LEAST_32_CHARACTERS_LONG",
    "Issuer": "CuraSphereStagingApi",
    "Audience": "CuraSphereStagingClient",
    "ExpiryInMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": "https://staging-clinic.curasphere.com,https://curasphere-staging.vercel.app"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "EditionSettings": {
    "CurrentEdition": "Clinic",
    "FacilityName": "CuraSphere Staging Healthcare Clinic"
  },
  "AllowedHosts": "*"
}
