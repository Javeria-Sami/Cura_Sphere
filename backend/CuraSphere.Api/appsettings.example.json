{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=curasphere_db;Username=postgres;Password=YOUR_SECURE_PASSWORD"
  },
  "JwtSettings": {
    "Secret": "YOUR_STRONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARACTERS_LONG",
    "Issuer": "CuraSphereApi",
    "Audience": "CuraSphereClient",
    "ExpiryInMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:3000,http://localhost:5173"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "AllowedHosts": "*"
}
