{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Error"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=prod-postgres.internal.cloud.provider;Port=5432;Database=curasphere_prod_db;Username=curasphere_prod_app;Password=REPLACE_WITH_PRODUCTION_PASSWORD;Ssl Mode=Require;Trust Server Certificate=false;"
  },
  "JwtSettings": {
    "Secret": "REPLACE_WITH_A_PRODUCTION_JWT_SECRET_KEY_AT_LEAST_32_CHARACTERS_LONG",
    "Issuer": "CuraSphereProductionApi",
    "Audience": "CuraSphereProductionClient",
    "ExpiryInMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": "https://clinic.curasphere.com"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "EditionSettings": {
    "CurrentEdition": "Clinic",
    "FacilityName": "CuraSphere Medical Clinic"
  },
  "AllowedHosts": "api.curasphere.com"
}
