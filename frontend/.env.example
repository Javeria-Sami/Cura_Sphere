# Backend API endpoint (leave as /api for same-origin proxy or Nginx reverse proxy)
# For remote HTTPS backend: https://api.yourdomain.com/api
VITE_API_URL=http://localhost:5000/api

# Software Deployment Edition: "Hospital" or "Clinic" (defaults to Hospital)
VITE_APP_EDITION=Clinic
