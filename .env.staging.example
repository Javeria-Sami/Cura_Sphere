# ==============================================================================
# CuraSphere Clinic Edition — Staging Environment Configuration Template
# FILE: .env.staging.example (DO NOT COMMIT REAL SECRETS)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Staging Database Configuration (PostgreSQL 15+ Managed Staging Instance)
# ------------------------------------------------------------------------------
POSTGRES_DB=curasphere_staging_db
POSTGRES_USER=curasphere_staging_app
POSTGRES_PASSWORD=generate_a_secure_random_staging_db_password_min_32_chars
POSTGRES_HOST=staging-postgres.internal.cloud.provider
POSTGRES_PORT=5432

# Staging EF Core Connection String format:
# ConnectionStrings__DefaultConnection=Host=staging-postgres.internal.cloud.provider;Port=5432;Database=curasphere_staging_db;Username=curasphere_staging_app;Password=YOUR_STAGING_PASSWORD;Ssl Mode=Require;Trust Server Certificate=true;

# ------------------------------------------------------------------------------
# 2. Staging JWT Security & Token Configuration
# ------------------------------------------------------------------------------
# Must be at least 32 characters (256 bits) for HMAC-SHA256 signature verification
JWT_SECRET=replace_with_a_secure_staging_signing_key_at_least_32_characters_long!
JWT_ISSUER=CuraSphereStagingApi
JWT_AUDIENCE=CuraSphereStagingClient
JWT_EXPIRY_MINUTES=60

# ------------------------------------------------------------------------------
# 3. ASP.NET Core Staging Runtime & CORS Policy
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Staging
# Enable controlled migration on staging container startup:
APPLY_MIGRATIONS=true
Database__ApplyMigrationsOnStartup=true

# Staging Frontend Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=https://staging-clinic.curasphere.com,https://curasphere-staging.vercel.app

# ------------------------------------------------------------------------------
# 4. Software Deployment Edition & Facility Identity
# ------------------------------------------------------------------------------
CURASPHERE_EDITION=Clinic
EditionSettings__CurrentEdition=Clinic
EditionSettings__FacilityName="CuraSphere Staging Healthcare Clinic"

# ------------------------------------------------------------------------------
# 5. Frontend Build-time Environment Variables (Vercel / Vite)
# ------------------------------------------------------------------------------
# Points frontend to the deployed staging backend API:
VITE_API_URL=https://staging-api.curasphere.com/api
VITE_APP_EDITION=Clinic
