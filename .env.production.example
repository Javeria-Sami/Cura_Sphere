# ==============================================================================
# CuraSphere Clinic Edition — Production Environment Configuration Template
# FILE: .env.production.example (DO NOT COMMIT REAL PRODUCTION CREDENTIALS)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Production Database Configuration (PostgreSQL 15+ Managed Cloud Instance)
# ------------------------------------------------------------------------------
POSTGRES_DB=curasphere_prod_db
POSTGRES_USER=curasphere_prod_app
POSTGRES_PASSWORD=GENERATE_A_CRYPTOGRAPHICALLY_SECURE_PASSWORD_MIN_32_CHARS
POSTGRES_HOST=prod-postgres.internal.cloud.provider
POSTGRES_PORT=5432

# Production EF Core Connection String format (SSL Required):
# ConnectionStrings__DefaultConnection=Host=prod-postgres.internal.cloud.provider;Port=5432;Database=curasphere_prod_db;Username=curasphere_prod_app;Password=YOUR_PROD_PASSWORD;Ssl Mode=Require;Trust Server Certificate=false;

# ------------------------------------------------------------------------------
# 2. Production JWT Security & Token Configuration
# ------------------------------------------------------------------------------
# Mandates minimum 32 characters (256 bits) for HMAC-SHA256 signature verification
JWT_SECRET=REPLACE_WITH_A_CRYPTOGRAPHICALLY_STRONG_256_BIT_SECRET_MIN_32_CHARS!
JWT_ISSUER=CuraSphereProductionApi
JWT_AUDIENCE=CuraSphereProductionClient
JWT_EXPIRY_MINUTES=60

# ------------------------------------------------------------------------------
# 3. ASP.NET Core Production Runtime & Strict CORS Policy
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
# In production, migrations should be applied via controlled pipeline or initial boot:
Database__ApplyMigrationsOnStartup=false

# Explicit Production Frontend Allowed Origins (Comma-separated, no wildcards)
CORS_ALLOWED_ORIGINS=https://clinic.curasphere.com

# ------------------------------------------------------------------------------
# 4. Software Deployment Edition & Facility Identity
# ------------------------------------------------------------------------------
CURASPHERE_EDITION=Clinic
EditionSettings__CurrentEdition=Clinic
EditionSettings__FacilityName="CuraSphere Medical Clinic"

# ------------------------------------------------------------------------------
# 5. Frontend Build-time Environment Variables (Vercel / Vite Production SPA)
# ------------------------------------------------------------------------------
# Points frontend to the deployed production backend API:
VITE_API_URL=https://api.curasphere.com/api
VITE_APP_EDITION=Clinic
